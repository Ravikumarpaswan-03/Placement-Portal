# Server Configuration
PORT=5000

# Database Configuration
# Local database fallback: mongodb://127.0.0.1:27017/placementportal
# For production, replace with your MongoDB Atlas connection string
MONGO_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/placementportal?retryWrites=true&w=majority

# Security Configuration
# Change this to a long, random, secure string in production
JWT_SECRET=your_jwt_secret_key_change_me_in_production

# Frontend URL (For CORS configuration in separate hosting)
# Local frontend address (e.g. VS Code Live Server defaults to http://127.0.0.1:5500)
# In production, set this to your deployed Vercel or Netlify URL
CLIENT_URL=http://localhost:5500
